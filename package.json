{
  "name": "peripheral-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/sync-vendor.mjs",
    "prebuild": "node scripts/sync-vendor.mjs",
    "start": "node scripts/start.mjs",
    "dev": "wrangler dev",
